# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated browser origins, e.g. "https://app.example.com,https://admin.example.com"
#   * production + unset => NO browser origin is allowed (native app uses Bearer tokens, unaffected)
#   * non-production + unset => "*" (local development convenience)
ALLOWED_ORIGINS=*

# Public origin used for email links (e.g. password reset redirect)
APP_URL=http://localhost:3000

# Rate limiting (all optional; leave unset to use the built-in defaults)
# Auth routes: 20 requests / 15 minutes
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Global API: 100 requests / 1 minute
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# Supabase — replace with your project's values. NEVER commit real keys.
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key